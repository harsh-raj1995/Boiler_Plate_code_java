// keep long[] nums for sum and target as well


public int upperBound(int[] nums, int target,int start,int end){
        int ans=end;
        while(start<end){
            int mid=(start+end)/2;
            if(nums[mid]>target){
                ans=mid;
                end=mid;
            }else{
                start=mid+1;
            }
        }
        return ans;     
    }